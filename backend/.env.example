# XCO MCP Client (COMMUNITY edition) — sample environment file
# Copy to .env and edit, or pass values via `docker run -e VAR=value`.
# The MCP base URL is also changeable from the UI (Server Settings) after
# the container is running — no restart required.

# ── MCP Server (required for first connect) ─────────────────────────────────
# Point at your auth-free community MCP server. There is NO authentication:
# no OAuth2, no client id/secret — the community server requires none.
MCP_BASE_URL=http://host.docker.internal:8000

# ── Local LLM (optional — leave 0 if not using Ollama) ──────────────────────
OLLAMA_ENABLED=0
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:3b-instruct
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_NUM_PARALLEL=2
OLLAMA_MAX_QUEUE=64
OLLAMA_MAX_TOKENS=96
OLLAMA_NUM_CTX=2048
OLLAMA_KEEP_ALIVE=20m
OLLAMA_MAX_CONTEXT_CHARS=2500
OLLAMA_NUM_THREAD=16
OLLAMA_FILTERS_ENABLED=1

# ── OpenAI (optional — easier to set at runtime via the UI AI Console) ──────
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
